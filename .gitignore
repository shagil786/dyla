# Local configuration and secrets
.env
.env.*
!.env.example

# Python caches and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Local runtime artifacts. logs/ is scratch -- the working directory a run
# writes into, keyed by opaque run_id and wiped by --fresh. The committed
# record lives in runs/, which is the same JSONL copied under readable names,
# and in reports/, which the brief asks for as a deliverable. Ignoring those
# would mean the graded artifacts only exist on the machine that ran them.
logs/
dyla.db
*.db
skill-observations/
.freebuff/
