# Provider-neutral Dyla configuration. Keep real secrets in .env or the process environment.
DYLA_MODEL_PROVIDER=compatible
DYLA_AUDITOR_PROVIDER=local
DYLA_EMBEDDING_PROVIDER=compatible
DYLA_VECTOR_STORE=local
DYLA_WEB_PROVIDER=you

# OpenAI-compatible model endpoint (OpenAI, OpenRouter, NVIDIA, Azure-compatible gateway, or local server).
DYLA_MODEL_BASE_URL=https://api.example.invalid/v1
DYLA_MODEL_API_KEY=replace-with-model-key
DYLA_MODEL_NAME=replace-with-chat-model

# Optional extra JSON fields merged into chat-completions request bodies (empty or unset = no change).
# Useful for reasoning models, e.g. disabling chain-of-thought on NVIDIA endpoints:
# DYLA_MODEL_EXTRA_PAYLOAD={"chat_template_kwargs":{"thinking":false}}
# DYLA_AUDITOR_EXTRA_PAYLOAD={"chat_template_kwargs":{"thinking":false}}

# Optional independent auditor model. Use DYLA_AUDITOR_PROVIDER=local for deterministic text comparison.
DYLA_AUDITOR_BASE_URL=https://api.example.invalid/v1
DYLA_AUDITOR_API_KEY=replace-with-auditor-key
DYLA_AUDITOR_MODEL=replace-with-auditor-model
# Auditor agent timing (defaults: 10s timeout, 2 retries). Raise the timeout for slow judge models.
# DYLA_AUDITOR_TIMEOUT_SECONDS=200
# DYLA_AUDITOR_RETRIES=2

# Durable memory database (default: dyla.db in the current directory). Point
# this at a fixed location so runs share memory regardless of where they are
# invoked from:
# DYLA_MEMORY_DB_PATH=~/.dyla/memory.db
# OpenAI-compatible embedding endpoint.
DYLA_EMBEDDING_BASE_URL=https://api.example.invalid/v1
DYLA_EMBEDDING_API_KEY=replace-with-embedding-key
DYLA_EMBEDDING_MODEL=replace-with-embedding-model

# You.com is the SearchProvider only; it is not used for models or embeddings.
YOU_API_KEY=replace-with-you-key
YOU_SEARCH_ENDPOINT=https://ydc-index.io/v1/search
YOU_CONTENTS_ENDPOINT=https://ydc-index.io/v1/contents

# Qdrant Cloud vector-store adapter (use DYLA_VECTOR_STORE=qdrant).
QDRANT_URL=https://qdrant.example.invalid
QDRANT_API_KEY=replace-with-qdrant-key
QDRANT_COLLECTION=dyla-evidence
QDRANT_VECTOR_DIMENSIONS=1536



# Any provider role may instead be module:function. The callable receives Settings.
# DYLA_MODEL_PROVIDER=my_package.providers:build_model
# DYLA_VECTOR_STORE=my_package.providers:build_vector_store
